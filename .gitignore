*.vsixlog
*.vsixdeblog
*.associated-executable
*.swp
*.lock
*.patch
*.diff

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS metadata
.DS_Store
Thumbs.db
