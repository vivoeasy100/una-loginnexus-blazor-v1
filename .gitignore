[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ww][Ww]root/lib/
[Bb]in/
[Oo]bj/
[Ll]og/
[Pp]ublish/

# Visual Studio 2015/2017/2019 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

